flowchart TB
  subgraph SA["a.) Pool behavioural sets by climate zone"]
    direction TB
    A["Behavioural parameter<br/>pool {θ_x}"] --> B["Map {θ_x} to<br/>Köppen-Geiger climate zones<br/>(Gaussian copula per zone)"] --> C["KG zone pools"]
  end
  subgraph SB["b.) Re-sample for a scenario and recompute the threshold"]
    direction TB
    D["Climate change scenario<br/>T* = T_HIST + Δt<br/>P* = P_HIST × Δp<br/>(121 ΔP × ΔT cells)"] --> E["Reclassify cell to<br/>Köppen-Geiger class"] --> F["Sample behavioural<br/>parameter sets θ_x<br/>from the zone-matched pool"] --> G["Run HBV with θ_x;<br/>compute the catchment<br/>vulnerability threshold"] --> H["Compare with the SPF<br/>threshold"]
  end
  classDef data fill:#fdf6e3,stroke:#a6611a,color:#4a2c07
  classDef model fill:#e8f1fa,stroke:#1f4e79,color:#0d2b45
  classDef param fill:#eaf5ea,stroke:#2e6b2e,color:#123d12
  classDef hypo fill:#fdf1e0,stroke:#a6611a,color:#4a2c07
  class A,D data
  class B,E,G model
  class C,F param
  class H hypo
