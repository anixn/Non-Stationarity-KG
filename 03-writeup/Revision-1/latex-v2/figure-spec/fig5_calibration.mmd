flowchart TB
    F["Forcing<br/>Temperature (T)<br/>Precipitation (P)<br/>Evapotranspiration (ET)"] --> M["Hydrological model<br/>(HBV, daily, 2-year warm-up)"]
    P["Parameter sets (θ)<br/>10,000 LHS draws<br/>θ1 = {x1, y1, z1, ...}<br/>θ2 = {x2, y2, z2, ...}<br/>θ3 = {x3, y3, z3, ...}"] --> M
    M --> Q["Simulated streamflow<br/>(Q_sim)"]
    O["Observed streamflow<br/>(Q_obs)"] --> E["Evaluation metrics<br/>KGE ≥ 0.5<br/>|PBIAS| ≤ 25%<br/>(NSE reported, not screened)"]
    Q --> E
    E -->|"if metrics outside range<br/>resample θ"| M
    E --> B["Behavioural parameter sets<br/>200 best-ranked per catchment<br/>(excluded if < 50 sets)"]
