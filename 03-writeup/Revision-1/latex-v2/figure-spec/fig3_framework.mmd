flowchart TB
  subgraph SA["a.) Climate scenarios and hydrological response"]
    direction TB
    A["Timeseries<br/>Precipitation (P)<br/>Temperature (T)"] --> B["Scenario grid<br/>T* = T_HIST + Δt<br/>P* = P_HIST × Δp"]
    C["Behavioural<br/>parameter sets (θ_x)"] --> D["Hydrological model<br/>(HBV)"]
    B --> D
    D --> E["Streamflow"]
  end
  subgraph SB["b.) Indicators, learning and vulnerability map"]
    direction TB
    F["Streamflow-based indicators<br/>Drought: C1 C2 C3<br/>Flood: C3 C2 C1<br/>MAR: C1 C2 C3"] --> G["Supervised ML<br/>(CART, RF, ...)"]
    G --> H["Vulnerability class map<br/>T* = T_HIST + Δt<br/>P* = P_HIST × Δp"]
  end
  classDef data fill:#fdf6e3,stroke:#a6611a,color:#4a2c07
  classDef model fill:#e8f1fa,stroke:#1f4e79,color:#0d2b45
  classDef param fill:#eaf5ea,stroke:#2e6b2e,color:#123d12
  class A,B,F,H data
  class D,E,G model
  class C param
